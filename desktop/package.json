{
  "name": "@ohmycode/desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Electron desktop client for OhMyCode",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"pnpm electron:dev\"",
    "build:packages": "pnpm --filter @ohmycode/protocol build && pnpm --filter @ohmycode/tool-contracts build && pnpm --filter @ohmycode/agent-runtime build && pnpm --filter @ohmycode/browser-use build",
    "electron:dev": "wait-on tcp:5173 && pnpm prepare:node-pty && pnpm build:packages && tsc -p electron/tsconfig.json && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "pnpm prepare:node-pty && pnpm build:packages && tsc -b && vite build && tsc -p electron/tsconfig.json",
    "test:file-tools": "pnpm build:packages && tsc -p electron/tsconfig.json && node electron/files/file-tools.smoke.mjs",
    "test:runtime": "pnpm build:packages && pnpm --filter @ohmycode/agent-runtime test && tsc -p electron/tsconfig.json && node electron/runtime/event-journal.smoke.mjs && node electron/runtime/sqlite-event-store.smoke.mjs",
    "test:ui": "vitest run",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "test:electron": "node --test tests/electron/*.test.mjs",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "dist:mac": "pnpm build && electron-builder --mac dmg --arm64 --x64",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "prepare:node-pty": "node scripts/ensure-node-pty-helper.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lexical/react": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@monaco-editor/react": "4.7.0",
    "@ohmycode/agent-runtime": "workspace:*",
    "@ohmycode/browser-use": "workspace:*",
    "@ohmycode/design-tokens": "workspace:*",
    "@ohmycode/protocol": "workspace:*",
    "@ohmycode/tool-contracts": "workspace:*",
    "@ohmycode/web-effects": "workspace:*",
    "@vitejs/plugin-react": "6.1.0",
    "fflate": "0.8.3",
    "i18next": "26.4.0",
    "lexical": "0.49.0",
    "lottie-web": "5.13.0",
    "lucide-react": "1.33.0",
    "mdast-util-from-markdown": "2.0.3",
    "monaco-editor": "0.56.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-markdown": "10.1.0",
    "react-photo-view": "1.2.7",
    "react-router-dom": "7.18.2",
    "react-virtuoso": "4.18.19",
    "remark-gfm": "4.0.1",
    "three": "0.185.1",
    "unist-util-visit": "5.1.0",
    "vite": "8.2.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/mdast": "4.0.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@types/ws": "8.18.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.1.3",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "5.0.5",
    "wait-on": "9.1.0"
  },
  "packageManager": "pnpm@10.15.0",
  "build": {
    "appId": "com.ohmycode.desktop",
    "productName": "OhMyCode",
    "npmRebuild": false,
    "artifactName": "OhMyCode-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OhMyCode uses the microphone for voice input."
      },
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
