# Compose
COMPOSE_PROJECT_NAME=ohmycode
EXPOSE_HTTP_PORT=80
EXPOSE_HTTPS_PORT=443

# Nginx
ENABLE_SSL=false
SSL_CERT_FILE=server.crt
SSL_KEY_FILE=server.key
CLIENT_MAX_BODY_SIZE=20m
PROXY_TIMEOUT=3600s

# Application security
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-an-independent-long-random-secret
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DB_USERNAME=ohmycode
DB_PASSWORD=change-this-password
DB_DATABASE=ohmycode
DB_PORT=5432
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_EFFECTIVE_CACHE_SIZE=4096MB
POSTGRES_STATEMENT_TIMEOUT=0
POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=0

# Redis and Celery
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO
MINIO_ROOT_USER=ohmycode
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-secret
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=ohmycode
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Gunicorn
SERVER_WORKER_AMOUNT=1
SERVER_WORKER_CLASS=gevent
SERVER_WORKER_CONNECTIONS=10
GUNICORN_TIMEOUT=360
GUNICORN_KEEP_ALIVE=75

# Capability retrieval
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_MODEL_VERSION=
EMBEDDING_DIMENSIONS=
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
RETRIEVAL_HTTP_TIMEOUT=30
