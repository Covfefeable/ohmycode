{
  "name": "@ohmycode/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@ohmycode/agent-runtime": "workspace:*",
    "@ohmycode/design-tokens": "workspace:*",
    "@ohmycode/protocol": "workspace:*",
    "@ohmycode/runtime-core": "workspace:*",
    "@ohmycode/tool-contracts": "workspace:*",
    "@ohmycode/web-effects": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "26.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "17.0.12",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.7",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build:packages": "pnpm --filter @ohmycode/design-tokens build && pnpm --filter @ohmycode/protocol build && pnpm --filter @ohmycode/tool-contracts build && pnpm --filter @ohmycode/runtime-core build && pnpm --filter @ohmycode/agent-runtime build",
    "start": "pnpm build:packages && expo start",
    "android": "pnpm build:packages && expo start --android",
    "ios": "pnpm build:packages && expo start --ios",
    "web": "pnpm build:packages && expo start --web",
    "lint": "pnpm build:packages && expo lint",
    "typecheck": "pnpm build:packages && tsc --noEmit"
  },
  "private": true
}
